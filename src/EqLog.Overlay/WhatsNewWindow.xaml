<Window x:Class="EqLog.Overlay.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New - EverQuest Log Overlay" Width="740" Height="680" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource NightBackground}" Foreground="{DynamicResource NightText}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Close" Key="Escape" />
    </Window.InputBindings>
    <DockPanel LayoutTransform="{DynamicResource DisplayScaleTransform}">
        <Button DockPanel.Dock="Bottom" Content="Close" Command="ApplicationCommands.Close"
                HorizontalAlignment="Right" Margin="12" />
        <FlowDocumentScrollViewer x:Name="WhatsNewViewer" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="{DynamicResource NightBackground}" />
    </DockPanel>
</Window>
