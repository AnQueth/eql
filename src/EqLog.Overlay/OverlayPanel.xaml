<UserControl x:Class="EqLog.Overlay.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EqLog.Overlay.Views"
             xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False" TextOptions.TextFormattingMode="Display"
             FontSize="{Binding FontSize, Mode=TwoWay}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/EqLogOverlay;component/Views/OverlayResources.xaml" />
                <!-- Per-overlay views: templates keyed {ViewModelType}.Header, .Toolbar and .Body. -->
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/DpsOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/SpellTimersOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/ItemListOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/QuestsOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/SkyOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/TradeskillsOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/ExaltationsOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/MobInfoOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/NpcsOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/InventoryOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/MergeOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/MotePlanOverlay.xaml" />
                <ResourceDictionary Source="/EqLogOverlay;component/Views/Overlays/LevelingOverlay.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="5,0,5,0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="{DynamicResource NightRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NightBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource NightText}" />
            </Style>

            <Style x:Key="Stud" TargetType="Border">
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="5" />
                <Setter Property="CornerRadius" Value="1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Black" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Background" Value="{DynamicResource Pumpkin}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Frame" CornerRadius="12">
        <Grid x:Name="FrameContent">
            <Border x:Name="Bevel" CornerRadius="5">
                <Border x:Name="Inset" CornerRadius="3">
                    <DockPanel x:Name="Layout" Grid.IsSharedSizeScope="True">
                        <Border x:Name="TitleFrame" DockPanel.Dock="Top" CornerRadius="3,3,0,0"
                                Visibility="{Binding IsHeaderHidden, Converter={StaticResource HiddenWhenTrue}}">
                            <DockPanel x:Name="Header">
                                <ContentControl x:Name="HeaderExtras" DockPanel.Dock="Bottom" Focusable="False"
                                                Content="{Binding}" ContentTemplateSelector="{StaticResource OverlayHeaderSelector}" />
                                <Thumb x:Name="DragHandleThumb" DockPanel.Dock="Left" Width="28" Height="22" Margin="0,0,6,0"
                                       Cursor="SizeAll" VerticalAlignment="Center" Focusable="False"
                                       ToolTip="Drag here to move this overlay. Only this grip moves it."
                                       IsEnabled="{Binding ShowDragHandle}"
                                       Visibility="{Binding ShowDragHandle, Converter={StaticResource VisibleWhenTrue}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource NightRaised}" BorderBrush="{DynamicResource Pumpkin}"
                                                    BorderThickness="1" CornerRadius="3">
                                                <TextBlock Text="&#x2630;" FontSize="12" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Pumpkin}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Button x:Name="DockButton" DockPanel.Dock="Right" Style="{StaticResource HeaderButton}"
                                        Content="{Binding DockButtonText}" ToolTip="{Binding DockButtonToolTip}"
                                        Command="{Binding ToggleDockCommand}"
                                        Visibility="{Binding ShowDockButton, Converter={StaticResource VisibleWhenTrue}}" />
                                <StackPanel x:Name="BackgroundControls" DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Top" TextElement.Foreground="{DynamicResource NightMuted}"
                                            Visibility="{Binding ShowBackgroundControls, Converter={StaticResource VisibleWhenTrue}}">
                                    <Slider x:Name="BackgroundSlider" Minimum="0" Maximum="1" TickFrequency="0.05" SmallChange="0.05"
                                            LargeChange="0.1" IsSnapToTickEnabled="True" Width="56" Height="18"
                                            VerticalAlignment="Top" Margin="4,0,0,0" Focusable="False"
                                            AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                            Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                            ToolTip="{Binding BackgroundOpacityToolTip}" />
                                </StackPanel>
                                <Button x:Name="WorkspaceButton" DockPanel.Dock="Right" Style="{StaticResource HeaderButton}"
                                        Content="Move to" ToolTip="Move this panel to another workspace"
                                        views:ContextMenuOnClick.IsEnabled="True"
                                        Visibility="{Binding ShowWorkspaceButton, Converter={StaticResource VisibleWhenTrue}}">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="WorkspaceMenu" ItemsSource="{Binding WorkspaceOptions}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                    <Setter Property="Command"
                                                            Value="{Binding DataContext.MoveToWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock x:Name="MoveHint" DockPanel.Dock="Right" Text="&#x2725;" FontSize="10" Foreground="Gray"
                                           Margin="4,0,0,0" HorizontalAlignment="Right"
                                           ToolTip="Unlocked: use the boxed header grip to move, drag edges to resize. Lock with Ctrl+Shift+L."
                                           Visibility="{Binding ShowMoveHint, Converter={StaticResource VisibleWhenTrue}}" />
                                <StackPanel x:Name="TitleStack">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Pumpkin}"
                                               views:ClickCommand.Command="{Binding OpenTitleLinkCommand}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTitleLink}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="ToolTip" Value="Open on EQLWiki" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource NightMuted}"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource HiddenWhenFalse}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ContentControl x:Name="Toolbar" DockPanel.Dock="Top" Focusable="False" Margin="0,4,0,6"
                                        Content="{Binding}" ContentTemplateSelector="{StaticResource OverlayToolbarSelector}" />
                        <ContentControl x:Name="BodyHost" Focusable="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                        VerticalContentAlignment="Stretch"
                                        Content="{Binding}" ContentTemplateSelector="{StaticResource OverlayBodySelector}" />
                    </DockPanel>
                </Border>
            </Border>
            <Grid x:Name="Ornaments" IsHitTestVisible="False"
                  Visibility="{Binding IsDocked, Converter={StaticResource VisibleWhenTrue}}">
                <Border Style="{StaticResource Stud}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Border Style="{StaticResource Stud}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Border Style="{StaticResource Stud}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Border Style="{StaticResource Stud}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
