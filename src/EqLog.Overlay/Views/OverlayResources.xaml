<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EqLog.Overlay"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">

    <views:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <views:BoolToVisibilityConverter x:Key="CollapsedWhenTrue" TrueValue="Collapsed" FalseValue="Visible" />
    <views:BoolToVisibilityConverter x:Key="HiddenWhenTrue" TrueValue="Hidden" FalseValue="Visible" />
    <views:BoolToVisibilityConverter x:Key="HiddenWhenFalse" TrueValue="Visible" FalseValue="Hidden" />
    <views:FontSizeOffsetConverter x:Key="SecondaryFontSize" />
    <views:ProductConverter x:Key="Product" />

    <!-- Text in a row's columns: row weight, and the row's color override when it has one. -->
    <Style x:Key="OverlayRowText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{Binding Weight, Mode=OneTime}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasForeground, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneTime}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayRowLeftText" TargetType="TextBlock" BasedOn="{StaticResource OverlayRowText}">
        <Setter Property="FontWeight" Value="{Binding LeftWeight, Mode=OneTime}" />
        <Setter Property="TextWrapping" Value="{Binding LeftWrapping, Mode=OneTime}" />
        <Setter Property="TextTrimming" Value="{Binding LeftTrimming, Mode=OneTime}" />
        <Setter Property="TextAlignment" Value="{Binding LeftAlignment, Mode=OneTime}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLeftUnderlined, Mode=OneTime}" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasForeground, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneTime}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayRowCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>

    <Style x:Key="OverlayRowRoot" TargetType="Grid">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource NightText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsQuestHeading, Mode=OneTime}" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Pumpkin}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsScaled, Mode=OneTime}" Value="True">
                <Setter Property="TextElement.FontSize">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource Product}">
                            <Binding Path="Owner.FontSize" />
                            <Binding Path="Scale" Mode="OneTime" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayCardTable" TargetType="views:OverlayTableView">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFirst, Mode=OneTime}" Value="True">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayCardDetails" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource NightMuted}" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DetailsIsFirst, Mode=OneTime}" Value="True">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayStackedRight" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Pumpkin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasForeground, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneTime}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One overlay row: optional card glass and bar behind a dock panel of controls, right columns and text. -->
    <DataTemplate x:Key="OverlayRowBody" DataType="{x:Type vm:OverlayRowViewModel}">
        <Grid x:Name="RowRoot" Style="{StaticResource OverlayRowRoot}" Margin="{Binding RowMargin, Mode=OneTime}"
              ToolTip="{Binding ToolTip, Mode=OneTime}">
            <Border x:Name="CardGlass" CornerRadius="6" Opacity="0.6" BorderThickness="1"
                    Background="{DynamicResource NightRaised}" BorderBrush="{DynamicResource NightBorder}"
                    Visibility="{Binding IsCard, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
            <Grid x:Name="RowBar" Visibility="{Binding HasBar, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding BarWidth, Mode=OneTime}" />
                    <ColumnDefinition Width="{Binding BarRemainder, Mode=OneTime}" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Bar, Mode=OneTime}" CornerRadius="2" />
            </Grid>
            <DockPanel x:Name="RowText" Margin="{Binding TextMargin, Mode=OneTime}">
                <CheckBox x:Name="SpawnTrack" Style="{StaticResource OverlayRowCheckBox}"
                          Visibility="{Binding ShowSpawnTrack, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}"
                          IsChecked="{Binding IsSpawnTracked, Mode=OneTime}" ToolTip="{Binding SpawnTrackToolTip, Mode=OneTime}"
                          Command="{Binding Owner.ToggleSpawnTrackCommand}" CommandParameter="{Binding}" />
                <CheckBox x:Name="SpellTrack" Style="{StaticResource OverlayRowCheckBox}"
                          Visibility="{Binding ShowSpellTrack, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}"
                          IsChecked="{Binding IsSpellTracked, Mode=OneTime}" ToolTip="{Binding SpellTrackToolTip, Mode=OneTime}"
                          Command="{Binding Owner.ToggleSpellTrackCommand}" CommandParameter="{Binding}" />
                <Button x:Name="WatchStar" DockPanel.Dock="Left" Content="{Binding WatchGlyph, Mode=OneTime}"
                        Visibility="{Binding ShowWatch, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}"
                        ToolTip="{Binding WatchToolTip, Mode=OneTime}" Background="Transparent" BorderThickness="0"
                        Padding="0,0,6,0" Margin="0" VerticalAlignment="Top" Cursor="Hand" Focusable="False"
                        Foreground="{DynamicResource Pumpkin}"
                        Command="{Binding Owner.ToggleWatchCommand}" CommandParameter="{Binding}" />
                <Grid x:Name="ExtraColumn" DockPanel.Dock="Right"
                      Visibility="{Binding ShowExtra, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="{Binding ExtraSizeGroup, Mode=OneTime}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OverlayRowText}" Text="{Binding ExtraColumn, Mode=OneTime}"
                               Width="{Binding ExtraWidth, Mode=OneTime}" TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>
                <Grid x:Name="RightColumn" DockPanel.Dock="Right"
                      Visibility="{Binding ShowRight, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="{Binding RightSizeGroup, Mode=OneTime}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OverlayRowText}" Text="{Binding Right, Mode=OneTime}"
                               MinWidth="{Binding RightMinWidth, Mode=OneTime}"
                               TextAlignment="{Binding RightAlignment, Mode=OneTime}" Margin="8,0,0,0" />
                </Grid>
                <Grid x:Name="ValueColumn" DockPanel.Dock="Right"
                      Visibility="{Binding ShowValue, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayValueColumn" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OverlayRowText}" Text="{Binding ValueColumn, Mode=OneTime}"
                               TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>
                <StackPanel x:Name="RowContent">
                    <TextBlock x:Name="LeftText" Style="{StaticResource OverlayRowLeftText}" Text="{Binding Left, Mode=OneTime}"
                               local:AlertEffects.Effect="{Binding Effect, Mode=OneTime}"
                               Visibility="{Binding ShowLeftText, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
                    <TextBlock x:Name="BadgeText" Style="{StaticResource OverlayRowLeftText}"
                               Visibility="{Binding ShowBadgeText, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}">
                        <Hyperlink FontWeight="SemiBold" Foreground="{DynamicResource Pumpkin}"
                                   ToolTip="Quest references available: click to view. Wiki mentions may include ingredients or rewards, not a turn-in checklist."
                                   Command="{Binding Owner.LookupQuestReferencesCommand}" CommandParameter="{Binding}">[Quest]</Hyperlink><Run Text="{Binding QuestBadgeText, Mode=OneTime}" />
                    </TextBlock>
                    <TextBlock x:Name="StackedRight" Style="{StaticResource OverlayStackedRight}" Text="{Binding Right, Mode=OneTime}"
                               Visibility="{Binding ShowStackedRight, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
                    <ItemsControl x:Name="CardTables" ItemsSource="{Binding Tables, Mode=OneTime}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverlayTablePart}">
                                <views:OverlayTableView Style="{StaticResource OverlayCardTable}" Table="{Binding Table, Mode=OneTime}"
                                                        FontSize="{Binding Owner.FontSize, Converter={StaticResource SecondaryFontSize}}"
                                                        LinkCommand="{Binding Owner.OpenLinkCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="CardDetails" Style="{StaticResource OverlayCardDetails}" Text="{Binding Details, Mode=OneTime}"
                               FontSize="{Binding Owner.FontSize, Converter={StaticResource SecondaryFontSize}}"
                               Visibility="{Binding ShowDetails, Mode=OneTime, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- A row with a click action: the whole row is a borderless button. Item rows add a context menu. -->
    <DataTemplate x:Key="OverlayClickableRow" DataType="{x:Type vm:OverlayRowViewModel}">
        <Button x:Name="RowButton" Content="{Binding}" ContentTemplate="{StaticResource OverlayRowBody}"
                Command="{Binding Owner.ActivateRowCommand}" CommandParameter="{Binding}"
                ClickMode="{Binding ClickMode, Mode=OneTime}" ToolTip="{Binding ClickToolTip, Mode=OneTime}"
                Margin="{Binding ClickMargin, Mode=OneTime}" Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalContentAlignment="Stretch" Cursor="Hand" Focusable="False"
                ContextMenuService.IsEnabled="{Binding HasLootItem, Mode=OneTime}">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open item on EQLWiki" Command="{Binding Owner.OpenItemWikiCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Look up quest references" Command="{Binding Owner.LookupQuestReferencesCommand}"
                              CommandParameter="{Binding}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </DataTemplate>

    <views:OverlayRowTemplateSelector x:Key="OverlayRowSelector"
                                      Plain="{StaticResource OverlayRowBody}"
                                      Clickable="{StaticResource OverlayClickableRow}" />

    <!-- The default overlay body: a scrolling row list. -->
    <DataTemplate x:Key="OverlayRows" DataType="{x:Type vm:OverlayViewModel}">
        <ScrollViewer x:Name="RowScroll" Margin="0,2,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                      Focusable="False" views:AutoScrollToEnd.IsEnabled="{Binding AutoScrollToEnd, Mode=OneTime}">
            <ItemsControl x:Name="RowItems" ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource OverlayRowSelector}"
                          Focusable="False" />
        </ScrollViewer>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowsRowScrollBar, Mode=OneTime}" Value="True">
                <Setter TargetName="RowScroll" Property="VerticalScrollBarVisibility" Value="Auto" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CentersRows, Mode=OneTime}" Value="True">
                <Setter TargetName="RowItems" Property="VerticalAlignment" Value="Center" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Long lists only build the rows on screen. -->
    <DataTemplate x:Key="OverlayVirtualRows" DataType="{x:Type vm:OverlayViewModel}">
        <views:VirtualRowList x:Name="RowList" ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource OverlayRowSelector}"
                              Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                              HorizontalContentAlignment="Stretch" Focusable="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <views:VirtualRowList.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </views:VirtualRowList.ItemsPanel>
            <views:VirtualRowList.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </views:VirtualRowList.ItemContainerStyle>
        </views:VirtualRowList>
    </DataTemplate>

    <views:OverlayPartTemplateSelector x:Key="OverlayHeaderSelector" Part="Header" />
    <views:OverlayPartTemplateSelector x:Key="OverlayToolbarSelector" Part="Toolbar" />
    <views:OverlayPartTemplateSelector x:Key="OverlayBodySelector" Part="Body"
                                       Fallback="{StaticResource OverlayRows}"
                                       VirtualFallback="{StaticResource OverlayVirtualRows}" />
</ResourceDictionary>
