<Window x:Class="EqLog.Overlay.Views.WorkspaceNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource NightBackground}" Foreground="{DynamicResource NightText}">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource NightRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NightBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource NightText}" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Workspace name" />
        <TextBox x:Name="NameBox" MinWidth="300" Margin="0,6,0,0" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Style="{StaticResource DialogButton}"
                    Click="Save_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
