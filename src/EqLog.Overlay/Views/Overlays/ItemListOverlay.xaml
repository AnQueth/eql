<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">

    <views:BoolToVisibilityConverter x:Key="ItemsVisibleWhenTrue" />

    <!-- Toolbar for loot, forage and item upgrades: the item name filter and, for loot and forage, the grouping. -->
    <DataTemplate x:Key="ItemListOverlayViewModel.Toolbar" DataType="{x:Type vm:ItemListOverlayViewModel}">
        <StackPanel>
            <TextBox x:Name="ItemFilter" Margin="0,3,0,3" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                     AutomationProperties.Name="Item name filter"
                     ToolTip="Filter by item name (case-insensitive). Clear to show all. Unlock floating panels to type." />
            <ComboBox x:Name="ItemGrouping" Margin="0,5,0,5" ItemsSource="{Binding GroupingOptions, Mode=OneTime}"
                      SelectedIndex="{Binding Grouping}" ToolTip="{Binding GroupingToolTip, Mode=OneTime}"
                      Visibility="{Binding HasGrouping, Mode=OneTime, Converter={StaticResource ItemsVisibleWhenTrue}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
