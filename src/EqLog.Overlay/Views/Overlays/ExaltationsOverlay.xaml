<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EqLog.Overlay"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EqLogOverlay;component/Views/OverlayResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="ExaltationsOverlayViewModel.Toolbar" DataType="{x:Type vm:ExaltationsOverlayViewModel}">
        <StackPanel Margin="0,3,0,3">
            <TextBlock Text="Find an exaltation by what it does. Each card names the exaltation, its effects, and the item carrying it. Locations come from your last /outputfile inventory."
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       ToolTip="Only base-item/effect names are sent to EQLWiki; host names and locations stay local."
                       Foreground="{DynamicResource NightMuted}" />
            <TextBlock Text="Export limitation: exaltations installed in items in Equipment storage may be omitted by /outputfile inventory. This list and search can be incomplete even after re-exporting. Wiki-default matches show expected effects, not confirmed ownership or installation. No match does not mean you do not own it. Check the in-game Find Item window."
                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Pumpkin}" />
            <TextBlock Text="Find effects, items, or locations:" Margin="0,0,0,4" />
            <TextBox x:Name="_exaltationSearch" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search what it does (string, bard instruments, haste), an exaltation, host item, or location. All words must match."
                     Margin="0,0,0,3" />
            <WrapPanel>
                <CheckBox x:Name="_exaltationsInstalledOnly" Content="Installed only"
                          IsChecked="{Binding InstalledOnly, Mode=OneWay}"
                          views:CheckChangedCommand.Command="{Binding SetInstalledOnlyCommand}"
                          ToolTip="Only installations confirmed by the export. Hides exalt storage, loose copies, and unverified wiki defaults."
                          Margin="0,0,10,0" VerticalAlignment="Center" />
                <Button x:Name="_refreshExaltations" Content="Refresh effects"
                        Command="{Binding RefreshEffectsCommand}"
                        ToolTip="Re-fetch base-item effects and descriptions. Does not refresh inventory; use /outputfile inventory in game."
                        local:UsageTracking.Action="RefreshExaltationEffects" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ExaltationsOverlayViewModel.Body" DataType="{x:Type vm:ExaltationsOverlayViewModel}">
        <views:VirtualRowList ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource OverlayRowSelector}"
                              Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                              HorizontalContentAlignment="Stretch" Focusable="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <views:VirtualRowList.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </views:VirtualRowList.ItemsPanel>
            <views:VirtualRowList.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </views:VirtualRowList.ItemContainerStyle>
        </views:VirtualRowList>
    </DataTemplate>
</ResourceDictionary>
