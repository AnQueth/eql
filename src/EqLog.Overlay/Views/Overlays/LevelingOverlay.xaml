<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">

    <views:BoolToVisibilityConverter x:Key="LevelingVisibleWhenTrue" />
    <views:BoolToVisibilityConverter x:Key="LevelingCollapsedWhenTrue" TrueValue="Collapsed" FalseValue="Visible" />

    <DataTemplate x:Key="LevelingOverlayViewModel.Toolbar" DataType="{x:Type vm:LevelingOverlayViewModel}">
        <StackPanel Margin="0,2,0,2" Language="{x:Static views:CultureLanguage.Current}">
            <WrapPanel>
                <ComboBox x:Name="LevelingDatePreset" ItemsSource="{Binding PresetOptions, Mode=OneTime}"
                          SelectedIndex="{Binding PresetIndex}" MinWidth="140" Margin="0,1,6,1"
                          ToolTip="Dates are inclusive and use the local game-log clock. All history leaves both dates unrestricted."
                          AutomationProperties.Name="Leveling date preset" />
                <TextBlock Text="From" Margin="0,1,6,1" VerticalAlignment="Center" />
                <DatePicker x:Name="LevelingFromDate" SelectedDate="{Binding FromDate}" Width="130"
                            Margin="0,1,6,1" SelectedDateFormat="Short"
                            ToolTip="Start of the inclusive leveling date range." />
                <TextBlock Text="To" Margin="0,1,6,1" VerticalAlignment="Center" />
                <DatePicker x:Name="LevelingToDate" SelectedDate="{Binding ToDate}" Width="130"
                            Margin="0,1,6,1" SelectedDateFormat="Short"
                            ToolTip="End of the inclusive leveling date range." />
            </WrapPanel>
            <WrapPanel>
                <ComboBox x:Name="LevelingView" ItemsSource="{Binding ViewOptions, Mode=OneTime}"
                          SelectedIndex="{Binding SelectedViewIndex}" MinWidth="100" Margin="0,1,6,1"
                          ToolTip="Levels shows each level's dates and XP sources. Best places compares continuous runs of the selected length."
                          AutomationProperties.Name="Leveling view" />
                <ComboBox x:Name="LevelingWindow" ItemsSource="{Binding WindowOptions, Mode=OneTime}"
                          SelectedIndex="{Binding WindowIndex}" MinWidth="95" Margin="0,1,6,1"
                          Visibility="{Binding IsBestPlacesView, Converter={StaticResource LevelingVisibleWhenTrue}}"
                          ToolTip="Find the fastest fully observed window of this length. Partial windows are not ranked."
                          AutomationProperties.Name="Leveling window" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Zone" Margin="0,1,6,1" VerticalAlignment="Center" />
                <TextBox x:Name="LevelingZone" Text="{Binding Zone, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                         Width="140" Margin="0,1,6,1"
                         ToolTip="Levels: find levels with activity in this zone; their full XP breakdown is retained. Best places: filter zones. Blank for all."
                         AutomationProperties.Name="Leveling zone filter" />
                <TextBlock Text="Level" Margin="0,1,6,1" VerticalAlignment="Center" />
                <TextBox x:Name="LevelingLevel" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                         Width="45" Margin="0,1,6,1"
                         ToolTip="Character level filter (blank for all levels). Rates are never combined across levels."
                         AutomationProperties.Name="Leveling character level" />
                <CheckBox x:Name="LevelingBuild" Content="Split XP by build" IsChecked="{Binding SplitByBuild}"
                          VerticalAlignment="Center" Margin="0,1,6,1"
                          ToolTip="Optional: split XP sources by class loadout observed through /who, without splitting the level. No historical loadout or gear is guessed."
                          AutomationProperties.Name="Split leveling XP by build" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LevelingOverlayViewModel.Body" DataType="{x:Type vm:LevelingOverlayViewModel}">
        <Grid>
            <DockPanel x:Name="LevelingGridBody"
                       Visibility="{Binding IsLevelsView, Converter={StaticResource LevelingVisibleWhenTrue}}">
                <TextBlock x:Name="LevelingGridStatus" DockPanel.Dock="Top" Text="{Binding GridStatus}"
                           TextWrapping="Wrap" Margin="4,4,4,8" Foreground="{DynamicResource NightMuted}"
                           Visibility="{Binding HasGridStatus, Converter={StaticResource LevelingVisibleWhenTrue}}" />
                <DataGrid x:Name="LevelingGrid" ItemsSource="{Binding GridRows}" IsReadOnly="True"
                          SelectedItem="{Binding SelectedGridRow}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserResizeRows="False" SelectionMode="Single"
                          SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinColumnWidth="50"
                          AlternationCount="2" RowDetailsVisibilityMode="VisibleWhenSelected"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          AutomationProperties.Name="Leveling history grid"
                          ToolTip="Newest level start first, then level descending. Select a row for XP sources and timestamp notes. Kills are your logged killing blows. Minutes include logged downtime but exclude gaps over 30 minutes.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartText}" Width="1*" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ended" Binding="{Binding EndText}" Width="1*" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level, TargetNullValue=Unknown}" Width="60" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Build at the time" Binding="{Binding Build}" Width="2*" MinWidth="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Kills" Binding="{Binding Kills}" Width="60" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Minutes" Binding="{Binding Minutes, StringFormat=0.##}" Width="80" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Details}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="8,4,8,6" />
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
            <ContentControl x:Name="LevelingRowBody" Content="{Binding}"
                            ContentTemplate="{DynamicResource OverlayRows}"
                            Visibility="{Binding IsBestPlacesView, Converter={StaticResource LevelingVisibleWhenTrue}}"
                            Focusable="False" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
