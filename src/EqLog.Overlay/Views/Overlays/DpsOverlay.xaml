<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EqLogOverlay;component/Views/OverlayResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <views:BoolToVisibilityConverter x:Key="DpsVisibleWhenTrue" />

    <!-- Toolbar: switch between attacker rows and full ability details. -->
    <DataTemplate x:Key="DpsOverlayViewModel.Toolbar" DataType="{x:Type vm:DpsOverlayViewModel}">
        <CheckBox x:Name="FullDetailsBox" Content="Full details" Margin="0,3,0,3" IsChecked="{Binding FullDetails}"
                  ToolTip="Show ability tables and damage graphs under expanded fights." />
    </DataTemplate>

    <!-- One fight: a header button that expands to attacker rows or full ability details. -->
    <DataTemplate x:Key="DpsFight" DataType="{x:Type vm:DpsFightViewModel}">
        <StackPanel x:Name="FightRoot">
            <Button x:Name="FightButton" Command="{Binding ToggleExpandedCommand}" Background="Transparent" BorderThickness="0"
                    Padding="4,3,4,3" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                    ToolTip="Expand or collapse this fight">
                <DockPanel>
                    <TextBlock x:Name="FightSummary" DockPanel.Dock="Right" Text="{Binding Summary}" TextAlignment="Right"
                               Margin="8,0,0,0" />
                    <views:WikiLabel x:Name="FightLabel" Subject="{Binding Target}" Kind="Mob">
                        <TextBlock x:Name="FightTarget" Text="{Binding Target}" ToolTip="{Binding Target}"
                                   TextTrimming="CharacterEllipsis" />
                    </views:WikiLabel>
                </DockPanel>
            </Button>
            <ContentControl x:Name="FightDetails" Margin="4,4,0,8" Focusable="False"
                            Visibility="{Binding IsExpanded, Converter={StaticResource DpsVisibleWhenTrue}}">
                <Grid>
                    <ContentControl x:Name="FightBreakdown" Content="{Binding Details}" Focusable="False"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding FullDetails, Converter={StaticResource DpsVisibleWhenTrue}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:AbilityDetailsViewModel}">
                                <views:AbilityDetailsView Height="180" />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <StackPanel x:Name="FightAttackers"
                                Visibility="{Binding ShowAttackers, Converter={StaticResource DpsVisibleWhenTrue}}">
                        <ItemsControl x:Name="AttackerRows" ItemsSource="{Binding Attackers}" Focusable="False"
                                      ItemTemplateSelector="{StaticResource OverlayRowSelector}" />
                        <TextBlock Text="No attackers recorded."
                                   Visibility="{Binding HasNoAttackers, Converter={StaticResource DpsVisibleWhenTrue}}" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </StackPanel>
    </DataTemplate>

    <!-- Body: recent fights, newest first, with a scroll bar. -->
    <DataTemplate x:Key="DpsOverlayViewModel.Body" DataType="{x:Type vm:DpsOverlayViewModel}">
        <ScrollViewer x:Name="FightScroll" Margin="0,2,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="NoFight" Text="No fight yet" Foreground="{DynamicResource NightMuted}"
                           Visibility="{Binding HasNoFights, Converter={StaticResource DpsVisibleWhenTrue}}" />
                <ItemsControl x:Name="FightList" ItemsSource="{Binding Fights}" ItemTemplate="{StaticResource DpsFight}"
                              Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
