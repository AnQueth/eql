<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EqLogOverlay;component/Views/OverlayResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <views:BoolToVisibilityConverter x:Key="TradeskillVisibleWhenTrue" />

    <DataTemplate x:Key="TradeskillsOverlayViewModel.Toolbar" DataType="{x:Type vm:TradeskillsOverlayViewModel}">
        <StackPanel Margin="0,3,0,2">
            <Grid x:Name="TradeskillFilterRow" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TradeskillSkills" Grid.Column="0" ItemsSource="{Binding Skills}"
                          SelectedItem="{Binding SelectedSkill}"
                          views:SelectionChangedCommand.Command="{Binding SelectSkillCommand}"
                          ToolTip="Choose a tradeskill. Unlock floating overlays to interact." />
                <TextBox x:Name="TradeskillSearch" Grid.Column="1" Margin="6,0,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                         VerticalContentAlignment="Center"
                         ToolTip="Search by recipe name or the item it makes" />
                <ComboBox x:Name="TradeskillSort" Grid.Column="2" Margin="6,0,0,0"
                          ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"
                          views:SelectionChangedCommand.Command="{Binding SelectSortCommand}"
                          ToolTip="Sort recipes by name or numeric trivial, then name. Unknown trivials sort last." />
                <Button x:Name="TradeskillWiki" Grid.Column="3" Content="Wiki" Margin="6,0,0,0"
                        Command="{Binding OpenWikiCommand}" />
                <Button x:Name="TradeskillRefresh" Grid.Column="4" Content="Refresh" Margin="6,0,0,0"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh this tradeskill, the selected recipe, and its ingredient merchants" />
            </Grid>
            <ComboBox x:Name="TradeskillRecipes" ItemsSource="{Binding RecipeChoices}"
                      SelectedItem="{Binding SelectedRecipeItem}"
                      views:SelectionChangedCommand.Command="{Binding SelectRecipeCommand}"
                      IsEnabled="{Binding IsRecipePickerEnabled}"
                      MaxDropDownHeight="350"
                      ToolTip="Choose a recipe or crafted item; different ingredient combinations remain separate">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <ComboBox x:Name="TradeskillCombines" Margin="0,2,0,0"
                      ItemsSource="{Binding CombineChoices}" SelectedItem="{Binding SelectedCombineItem}"
                      views:SelectionChangedCommand.Command="{Binding SelectCombineCommand}"
                      Visibility="{Binding HasCombineChoices, Converter={StaticResource TradeskillVisibleWhenTrue}}"
                      ToolTip="Alternate combines listed on the crafted item's wiki page">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox x:Name="TradeskillCurrentZoneOnly" Content="Current-zone merchants only"
                      IsChecked="{Binding CurrentZoneOnly, Mode=OneWay}"
                      views:CheckChangedCommand.Command="{Binding CurrentZoneOnlyCommand}"
                      Margin="0,6,0,4" ToolTip="Uses the zone from your log. Every ingredient stays visible." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TradeskillsOverlayViewModel.Body" DataType="{x:Type vm:TradeskillsOverlayViewModel}">
        <views:VirtualRowList ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource OverlayRowSelector}"
                              Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                              HorizontalContentAlignment="Stretch" Focusable="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <views:VirtualRowList.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </views:VirtualRowList.ItemsPanel>
            <views:VirtualRowList.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </views:VirtualRowList.ItemContainerStyle>
        </views:VirtualRowList>
    </DataTemplate>
</ResourceDictionary>
