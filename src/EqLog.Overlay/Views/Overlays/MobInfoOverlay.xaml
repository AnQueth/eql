<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <views:BoolToVisibilityConverter x:Key="MobInfoVisibleWhenTrue" />

    <DataTemplate x:Key="MobInfoOverlayViewModel.Toolbar" DataType="{x:Type vm:MobInfoOverlayViewModel}">
        <StackPanel>
            <WrapPanel>
                <Button x:Name="RefreshMobWikiButton" Content="Refresh wiki" FontSize="11"
                        Command="{Binding RefreshWikiCommand}" ToolTip="Refresh mob and spell information from EQLWiki." />
                <Button x:Name="OpenMobWikiButton" Content="Wiki" FontSize="11"
                        Command="{Binding OpenWikiCommand}" ToolTip="Open the current mob's EQLWiki page." />
                <Button x:Name="ResetResistanceButton" Content="Reset resistances" FontSize="11"
                        Command="{Binding BeginResetCommand}"
                        ToolTip="Clear this mob's observed resistances in this zone only. Wiki data and other mobs are kept." />
            </WrapPanel>
            <StackPanel x:Name="ResetConfirmation" Margin="0,6,0,0"
                        Visibility="{Binding IsResetConfirmationVisible, Converter={StaticResource MobInfoVisibleWhenTrue}}">
                <TextBlock Text="{Binding ResetConfirmationText}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button x:Name="ConfirmResetButton" Content="Confirm reset" FontSize="11"
                            Command="{Binding ConfirmResetCommand}" />
                    <Button x:Name="CancelResetButton" Content="Cancel" FontSize="11"
                            Command="{Binding CancelResetCommand}" IsEnabled="{Binding CanCancelReset}" />
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="ResetResult" Text="{Binding ResetResultText}" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding HasResetResult, Converter={StaticResource MobInfoVisibleWhenTrue}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MobInfoOverlayViewModel.Body" DataType="{x:Type vm:MobInfoOverlayViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource OverlayRows}" />
    </DataTemplate>
</ResourceDictionary>
