<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <DataTemplate x:Key="SkyOverlayViewModel.Toolbar" DataType="{x:Type vm:SkyOverlayViewModel}">
        <StackPanel>
            <DockPanel Margin="0,3,0,2">
                <Button x:Name="SkyRefresh" Content="Refresh" Margin="6,0,0,0" ToolTip="Reload quests and drop sources from EQLWiki"
                        Command="{Binding RefreshCommand}" DockPanel.Dock="Right" />
                <Button x:Name="SkyWiki" Content="Wiki" Margin="6,0,0,0" ToolTip="Open the Plane of Sky page on EQLWiki"
                        Command="{Binding OpenWikiCommand}" DockPanel.Dock="Right" />
                <TextBox x:Name="SkyFilter" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="100" VerticalContentAlignment="Center"
                         ToolTip="Search quests, rewards, items, and droppers. Unlock floating panels to type."
                         AutomationProperties.Name="Sky quest filter" />
            </DockPanel>
            <ComboBox x:Name="SkyClass" ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}"
                      ToolTip="Class filter for By class and By dropper. Watching shows every watched quest." />
            <TabControl x:Name="SkyViews" SelectedIndex="{Binding SelectedTabIndex}"
                        Padding="0" BorderThickness="0" Margin="0,2,0,2">
                <TabItem Header="By class" />
                <TabItem Header="By dropper" />
                <TabItem Header="Need"
                         ToolTip="Only items you still need for the filtered quests, grouped by boss" />
                <TabItem Header="Watching" />
            </TabControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SkyOverlayViewModel.Body" DataType="{x:Type vm:SkyOverlayViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource OverlayVirtualRows}" />
    </DataTemplate>
</ResourceDictionary>
