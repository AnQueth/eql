<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <views:BoolToVisibilityConverter x:Key="NpcVisibleWhenTrue" />

    <DataTemplate x:Key="NpcBrowserOverlayViewModel.Toolbar" DataType="{x:Type vm:NpcBrowserOverlayViewModel}">
        <StackPanel>
            <DockPanel x:Name="NpcSearchRow" Margin="0,2,0,2">
                <Button x:Name="NpcLookupButton" DockPanel.Dock="Right" Content="Look up name"
                        Command="{Binding LookupNameCommand}"
                        ToolTip="Look up the exact typed NPC name even without recorded encounters." />
                <TextBox x:Name="NpcSearch" MinWidth="100" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter saved NPC names; choose a name/zone below. Unlock floating panels to type." />
            </DockPanel>
            <ComboBox x:Name="NpcChoices" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                      MaxDropDownHeight="320"
                      ToolTip="Recorded NPCs, separated by the full logged zone name.">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NpcChoice}">
                        <views:WikiLabel x:Name="NpcChoiceLabel" Subject="{Binding Mob}" Kind="Mob">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </views:WikiLabel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel x:Name="NpcActions" Margin="0,2,0,0">
                <Button x:Name="NpcRefreshWikiButton" Content="Refresh wiki" FontSize="11"
                        Padding="8,3,8,3" Command="{Binding RefreshWikiCommand}" />
                <Button x:Name="NpcOpenWikiButton" Content="Open wiki" FontSize="11"
                        Padding="8,3,8,3" Command="{Binding OpenWikiCommand}" />
                <Button x:Name="NpcDpsHistoryButton" Content="{Binding DpsHistoryButtonText}" FontSize="11"
                        Padding="8,3,8,3" Command="{Binding OpenDpsHistoryCommand}"
                        ToolTip="Compare saved DPS for this NPC and zone by character, class loadout, and level; click fights for details." />
            </WrapPanel>
            <TabControl x:Name="NpcViews" Padding="0" BorderThickness="0" Margin="0,2,0,2"
                        SelectedIndex="{Binding ViewIndex, Mode=TwoWay}">
                <TabItem Header="Overview" />
                <TabItem Header="Spell resists" />
                <TabItem Header="Encounters" />
            </TabControl>
            <WrapPanel x:Name="NpcPager" Margin="0,0,0,2"
                       Visibility="{Binding IsEncounterView, Converter={StaticResource NpcVisibleWhenTrue}}">
                <Button x:Name="NpcPreviousPage" Content="Newer" FontSize="11" Padding="8,3,8,3"
                        Command="{Binding PreviousPageCommand}" />
                <Button x:Name="NpcNextPage" Content="Older" FontSize="11" Padding="8,3,8,3"
                        Command="{Binding NextPageCommand}" />
                <TextBlock x:Name="NpcPageLabel" Text="{Binding PageLabel}" VerticalAlignment="Center"
                           Margin="8,0,0,3" FontSize="11" Foreground="{DynamicResource NightMuted}" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NpcBrowserOverlayViewModel.Body" DataType="{x:Type vm:NpcBrowserOverlayViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource OverlayVirtualRows}" />
    </DataTemplate>
</ResourceDictionary>
