<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EqLog.Overlay"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <views:BoolToVisibilityConverter x:Key="MergeVisibleWhenTrue" />

    <DataTemplate x:Key="MergeOverlayViewModel.Toolbar" DataType="{x:Type vm:MergeOverlayViewModel}">
        <TextBox x:Name="MergeFilter" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                 ToolTip="Filter by item name or location (case-insensitive). Clear to show all."
                 AutomationProperties.Name="Merge item or location filter" />
    </DataTemplate>

    <DataTemplate x:Key="MergeOverlayViewModel.Body" DataType="{x:Type vm:MergeOverlayViewModel}">
        <DockPanel Margin="2,3,2,2">
            <TextBlock x:Name="MergeSummary" DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap"
                       Foreground="{DynamicResource NightMuted}" Margin="0,0,0,3" />
            <ListBox x:Name="MergeGroups" ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0"
                     Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MergeGroupViewModel}">
                        <StackPanel>
                            <TextBlock x:Name="MergeGroupHeading" FontWeight="SemiBold" Margin="0,12,0,5"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NightText}">
                                <Hyperlink Tag="{Binding BaseName}" ToolTip="Open item on EQLWiki"
                                           Foreground="{DynamicResource Pumpkin}"
                                           views:ClickCommand.Command="{Binding DataContext.OpenMergeItemWikiCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           views:ClickCommand.CommandParameter="{Binding BaseName}"><Run Text="{Binding BaseName, Mode=OneWay}" /></Hyperlink>
                                <Run Text="  ·  " />
                                <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0} copies}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,0,3" Foreground="{DynamicResource Pumpkin}"
                                       Visibility="{Binding HasQuestReferences, Converter={StaticResource MergeVisibleWhenTrue}}">
                                <Hyperlink Tag="{Binding BaseName}"
                                           ToolTip="Quest references available: click to view. Wiki mentions may include ingredients or rewards, not a turn-in checklist."
                                           Foreground="{DynamicResource Pumpkin}"
                                           views:ClickCommand.Command="{Binding DataContext.LookupMergeQuestReferencesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           views:ClickCommand.CommandParameter="{Binding BaseName}"><Run Text="[Quest]" /></Hyperlink>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Tables}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:OverlayTableView Table="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
