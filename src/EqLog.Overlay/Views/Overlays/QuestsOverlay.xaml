<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <DataTemplate x:Key="QuestsOverlayViewModel.Toolbar" DataType="{x:Type vm:QuestsOverlayViewModel}">
        <StackPanel Margin="0,3,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="QuestSort" ItemsSource="{Binding SortOptions, Mode=OneTime}"
                          SelectedIndex="{Binding SortIndex}" Width="155" Margin="0,0,10,0"
                          ToolTip="Sort quests by latest looted item (inventory-only items last), or alphabetically." />
                <TextBox x:Name="QuestFilter" Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by item or quest name (case-insensitive). Clear to show all."
                         AutomationProperties.Name="Quest and item filter" />
            </Grid>
            <ProgressBar x:Name="QuestProgress" Height="8" Minimum="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                         Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,5,0,3"
                         ToolTip="Completed checks, including failed attempts. Failed items can be retried from the Inventory &amp; loot quests overlay." />
            <views:OverlayTableView x:Name="QuestProgressMetrics" Table="{Binding ProgressTable, Mode=OneWay}"
                                    Margin="0" TextElement.FontSize="11" />
            <TextBlock x:Name="QuestCurrentText" Text="{Binding CurrentStatus}" TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,3" Foreground="{DynamicResource NightMuted}" ToolTip="{Binding CurrentStatus}" />
            <TextBlock Text="Matches are wiki mentions, not a ready-to-turn-in checklist."
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource NightMuted}"
                       ToolTip="An item may be an ingredient, a reward, or a walkthrough mention. This list does not analyze required quantities, other ingredients, faction, or prerequisites. Use the dedicated Sky tracker for parsed Plane of Sky ingredient counts." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="QuestsOverlayViewModel.Body" DataType="{x:Type vm:QuestsOverlayViewModel}">
        <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource OverlayVirtualRows}" />
    </DataTemplate>
</ResourceDictionary>
