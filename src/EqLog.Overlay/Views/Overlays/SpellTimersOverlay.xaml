<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EqLog.Overlay"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">

    <views:BoolToVisibilityConverter x:Key="TimersVisibleWhenTrue" />

    <!-- Header: show or hide known spells without affecting running timers or tracking. -->
    <DataTemplate x:Key="SpellTimersOverlayViewModel.Header" DataType="{x:Type vm:SpellTimersOverlayViewModel}">
        <CheckBox x:Name="KnownSpellsBox" Content="Known spells" IsChecked="{Binding ShowKnownSpells}" FontSize="11"
                  Margin="3,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"
                  local:UsageTracking.Action="ToggleKnownSpells"
                  ToolTip="Show or hide known spells without affecting active timers or spell tracking." />
    </DataTemplate>

    <!-- Toolbar: the known-spells name filter, shown only while known spells are listed. -->
    <DataTemplate x:Key="SpellTimersOverlayViewModel.Toolbar" DataType="{x:Type vm:SpellTimersOverlayViewModel}">
        <TextBox x:Name="KnownSpellsFilter" Margin="0,5,0,5" VerticalContentAlignment="Center"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                 AutomationProperties.Name="Known spells filter"
                 Visibility="{Binding ShowKnownSpells, Converter={StaticResource TimersVisibleWhenTrue}}"
                 ToolTip="Filter known spells by name (case-insensitive). Clear to show all. Unlock floating panels to type." />
    </DataTemplate>
</ResourceDictionary>
