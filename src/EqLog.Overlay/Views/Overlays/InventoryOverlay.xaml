<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:EqLog.Overlay"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views"
                    xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels">
    <views:BoolToVisibilityConverter x:Key="InventoryVisibleWhenTrue" />

    <DataTemplate x:Key="InventoryOverlayViewModel.Body" DataType="{x:Type vm:InventoryOverlayViewModel}">
        <DockPanel Margin="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Foreground="{DynamicResource NightMuted}" Text="{Binding Inventory.ImportStatus}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,3,0,3">
                    <Button x:Name="LookupQuestButton" Content="Look up quests" Command="{Binding LookupSelectedQuestReferencesCommand}"
                            ToolTip="Look up quest references for the selected item." />
                    <Button Content="Item wiki page" Command="{Binding OpenSelectedItemWikiCommand}"
                            local:UsageTracking.Action="OpenItemWiki" ToolTip="Open the selected item on EQLWiki." />
                    <Button Content="Open selected quest" Command="{Binding OpenSelectedQuestCommand}"
                            local:UsageTracking.Action="OpenQuest" ToolTip="Open the selected quest reference on EQLWiki." />
                    <Button Content="Complete / reopen quest" Command="{Binding ToggleQuestCompletionCommand}"
                            local:UsageTracking.Action="CompleteQuest" ToolTip="Toggle completion for the selected quest reference." />
                    <Button Content="Retry lookups" Command="{Binding RetryQuestLookupsCommand}"
                            local:UsageTracking.Action="RetryQuestLookups" ToolTip="Retry automatic quest-reference lookups." />
                </WrapPanel>
                <TextBlock Text="YOUR INVENTORY" Foreground="{DynamicResource NightMuted}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,4,0,2" />
                <TextBox x:Name="InventoryItemFilter" Margin="0,0,0,4" VerticalContentAlignment="Center"
                         Text="{Binding Inventory.Filter, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                         AutomationProperties.Name="Item name filter"
                         ToolTip="Filter inventory by item name (case-insensitive). Clear to show all. Unlock floating panels to type." />
            </StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="90" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="3*" MinHeight="90" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="QuestOwnedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          ItemsSource="{Binding Inventory.ItemsView}" SelectedItem="{Binding Inventory.SelectedItem, Mode=TwoWay}"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MinColumnWidth="70"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Item" IsReadOnly="True" Width="*" MinWidth="190" SortMemberPath="Item">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" FontWeight="SemiBold"
                                                   Visibility="{Binding HasQuestReferences, Converter={StaticResource InventoryVisibleWhenTrue}}">
                                            <Hyperlink Foreground="{DynamicResource Pumpkin}"
                                                       ToolTip="Quest references available: click to view. Wiki mentions may include ingredients or rewards, not a turn-in checklist."
                                                       views:ClickCommand.Command="{Binding DataContext.LookupQuestItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       views:ClickCommand.CommandParameter="{Binding Item}"><Run Text="[Quest]" /></Hyperlink>
                                        </TextBlock>
                                        <views:WikiLabel x:Name="InventoryItemLabel" Subject="{Binding Item}">
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Hyperlink Foreground="{DynamicResource Pumpkin}"
                                                           ToolTip="Show all copy locations and quest references. Use Item wiki page to open EQLWiki."
                                                           views:ClickCommand.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           views:ClickCommand.CommandParameter="{Binding}"><Run Text="{Binding Item}" /></Hyperlink>
                                            </TextBlock>
                                        </views:WikiLabel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Carried" Binding="{Binding Carried}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Hoard" Binding="{Binding Hoard}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Depot" Binding="{Binding Depot}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Other" Binding="{Binding OtherStorage}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Collection" Binding="{Binding Collection}" IsReadOnly="True" MinWidth="90" />
                        <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" IsReadOnly="True" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource NightBorder}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize the inventory and copy-location lists" />
                <TabControl x:Name="InventoryDetailsTabs" Grid.Row="2"
                            SelectedIndex="{Binding SelectedDetailsTabIndex, Mode=TwoWay}">
                    <TabItem Header="Copy locations">
                        <DockPanel>
                            <TextBlock x:Name="InventoryCopiesStatus" DockPanel.Dock="Top" TextWrapping="Wrap"
                                       Foreground="{DynamicResource NightMuted}" Margin="0,4,0,6" Text="{Binding Inventory.CopyStatus}" />
                            <DataGrid x:Name="InventoryCopiesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      ItemsSource="{Binding Inventory.Copies}" CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Single" AutomationProperties.Name="Selected item copy locations"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" MinWidth="170" />
                                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank, StringFormat=+{0}}" Width="55" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" MinWidth="240" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Quest references">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="QUEST REFERENCES" Foreground="{DynamicResource NightMuted}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,4,0,4" />
                                <TextBlock x:Name="QuestLookupStatus" Text="{Binding QuestStatus}" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Foreground="{DynamicResource Pumpkin}" />
                            </StackPanel>
                            <ListBox x:Name="QuestResults" ItemsSource="{Binding QuestReferences}"
                                     SelectedItem="{Binding SelectedQuestReference, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch"
                                     ToolTip="Click a quest name to open it on EQLWiki, or select a row and use Open selected quest."
                                     AutomationProperties.Name="Quest references for selected inventory item">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Hyperlink Foreground="{DynamicResource Pumpkin}" ToolTip="Open quest on EQLWiki"
                                                       views:ClickCommand.Command="{Binding DataContext.OpenQuestCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       views:ClickCommand.CommandParameter="{Binding Url}">
                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
