<UserControl x:Class="EqLog.Overlay.Views.OverlayTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EqLog.Overlay.Views">
    <ItemsControl x:Name="Cells" Margin="0,3,0,0" Focusable="False" IsTabStop="False"
                  DataContext="{Binding Layout, RelativeSource={RelativeSource AncestorType=views:OverlayTableView}}"
                  ItemsSource="{Binding Items}">
        <ItemsControl.Resources>
            <DataTemplate DataType="{x:Type views:OverlayTableRule}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GridLine}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:OverlayTableStripe}">
                <Border CornerRadius="2" Opacity="0.7" Background="{DynamicResource Alternate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:OverlayTableCell}">
                <TextBlock x:Name="Cell" Text="{Binding Text, Mode=OneTime}" Margin="{Binding Margin, Mode=OneTime}"
                           VerticalAlignment="Top" TextWrapping="NoWrap"
                           views:ClickCommand.CommandParameter="{Binding Url, Mode=OneTime}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Wraps, Mode=OneTime}" Value="True">
                        <Setter TargetName="Cell" Property="TextWrapping" Value="Wrap" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsNumeric, Mode=OneTime}" Value="True">
                        <Setter TargetName="Cell" Property="TextAlignment" Value="Right" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static views:OverlayTableCellKind.Header}">
                        <Setter TargetName="Cell" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Cell" Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter TargetName="Cell" Property="Foreground" Value="{DynamicResource NightMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static views:OverlayTableCellKind.Label}">
                        <Setter TargetName="Cell" Property="Foreground" Value="{DynamicResource NightMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static views:OverlayTableCellKind.LabelValue}">
                        <Setter TargetName="Cell" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <!-- ClickCommand marks the press handled, so a clickable card around the link does not also act. -->
                    <DataTrigger Binding="{Binding IsLink, Mode=OneTime}" Value="True">
                        <Setter TargetName="Cell" Property="TextDecorations" Value="Underline" />
                        <Setter TargetName="Cell" Property="Cursor" Value="Hand" />
                        <Setter TargetName="Cell" Property="ToolTip" Value="Open on EQLWiki" />
                        <Setter TargetName="Cell" Property="HorizontalAlignment" Value="Left" />
                        <Setter TargetName="Cell" Property="Background" Value="Transparent" />
                        <Setter TargetName="Cell" Property="views:ClickCommand.Command"
                                Value="{Binding LinkCommand, RelativeSource={RelativeSource AncestorType=views:OverlayTableView}}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.Resources>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid views:GridDefinitions.Columns="{Binding Columns}" views:GridDefinitions.AutoRows="{Binding RowCount}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Grid.Row" Value="{Binding Row, Mode=OneTime}" />
                <Setter Property="Grid.Column" Value="{Binding Column, Mode=OneTime}" />
                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan, Mode=OneTime}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
    </ItemsControl>
</UserControl>
