<Window x:Class="EqLog.Overlay.AbilityBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EqLog.Overlay.Views"
        Title="{Binding WindowTitle}" Width="850" Height="480" MinWidth="540" MinHeight="280"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NightBackground}"
        Foreground="{DynamicResource NightText}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="BreakdownTitle" Text="{Binding Breakdown.Title}" FontSize="21"
                       FontWeight="Bold" Foreground="{DynamicResource Pumpkin}" />
            <TextBlock Text="{Binding Breakdown.Context}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource NightMuted}" />
            <TextBlock Text="{Binding TotalSummary}" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="Snapshot captured when clicked. Rates use the displayed fight/session healing span, not the rolling 30-second meter. Melee and Ranged are separate; spell and proc damage uses each logged effect name and rank. The log may not distinguish a proc from a cast of the same spell."
                   TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource NightMuted}" />
        <views:AbilityDetailsView x:Name="Details" DataContext="{Binding Details}" />
    </DockPanel>
</Window>
