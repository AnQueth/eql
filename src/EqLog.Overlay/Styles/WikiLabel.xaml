<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:EqLog.Overlay.Views">
    <!-- Wiki item icon or mob portrait beside a name; portraits are cropped to a rounded square. -->
    <Style TargetType="views:WikiLabel">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:WikiLabel">
                    <DockPanel>
                        <Border x:Name="PART_Icon" DockPanel.Dock="Left" Visibility="Collapsed" Margin="0,0,6,0"
                                Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                VerticalAlignment="{TemplateBinding IconVerticalAlignment}"
                                ClipToBounds="True" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource NightBorder}" Background="{DynamicResource NightRaised}">
                            <Image x:Name="PART_Image" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Icon.Image, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icon.HasImage, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon.IsMob, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_Image" Property="Stretch" Value="UniformToFill" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
