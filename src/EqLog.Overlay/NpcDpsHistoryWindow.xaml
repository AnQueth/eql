<Window x:Class="EqLog.Overlay.NpcDpsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1100" Height="800" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NightBackground}" Foreground="{DynamicResource NightText}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Heading}" FontSize="20" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource NightMuted}"
                   Text="Snapshot when opened; reopen for new fights. Character, reported classes, and level stay separate; unknown loadouts are not guessed. Active, zoned, death, and loadout-change segments appear in history but do not enter comparison averages. Mean gives each completed fight equal weight. P90/P99 are nearest-rank percentiles of completed fight DPS; small samples may equal best DPS. Durations include incoming damage and run through last activity (+1 second). Gear, buffs, debuffs and other attackers can affect comparisons. Named effects retain exact ranks; identical proc/cast names share a row. Older saved physical damage may still be combined as Melee. Landings are confirmed direct casts, not hit counts. Crits, max hits, and timelines were not saved in this history." />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Loadouts" ItemsSource="{Binding Loadouts}" SelectedItem="{Binding SelectedLoadout}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="Auto" />
                    <DataGridTextColumn Header="Loadout" Binding="{Binding Classes, TargetNullValue=Unknown}" Width="Auto" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level, TargetNullValue=?}" Width="Auto" />
                    <DataGridTextColumn Header="Encounters" Binding="{Binding Encounters, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="NPC deaths" Binding="{Binding CompletedFights, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="Damage (deaths)" Binding="{Binding Damage, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="Seconds (deaths)" Binding="{Binding Seconds, StringFormat=N1}" Width="Auto" />
                    <DataGridTextColumn Header="Weighted average DPS" Binding="{Binding AverageDps, StringFormat=N1, TargetNullValue='No completed fights'}" Width="Auto" />
                    <DataGridTextColumn Header="Mean DPS" Binding="{Binding MeanDps, StringFormat=N1, TargetNullValue=-}" Width="Auto" />
                    <DataGridTextColumn Header="P90 DPS" Binding="{Binding P90Dps, StringFormat=N1, TargetNullValue=-}" Width="Auto" />
                    <DataGridTextColumn Header="P99 DPS" Binding="{Binding P99Dps, StringFormat=N1, TargetNullValue=-}" Width="Auto" />
                    <DataGridTextColumn Header="Best DPS" Binding="{Binding BestDps, StringFormat=N1, TargetNullValue=-}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="Encounters for selected loadout" Margin="0,8,0,4" />
            <DataGrid x:Name="Encounters" Grid.Row="2" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Started" Binding="{Binding Start, StringFormat=g}" Width="Auto" />
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="Auto" />
                    <DataGridTextColumn Header="Your damage" Binding="{Binding Damage, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds, StringFormat=N1}" Width="Auto" />
                    <DataGridTextColumn Header="Your DPS" Binding="{Binding Dps, StringFormat=N1}" Width="Auto" />
                    <DataGridTextColumn Header="Others' damage" Binding="{Binding OtherDamage, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="Damage taken" Binding="{Binding IncomingDamage, StringFormat=N0}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="{Binding Details}" Margin="0,8,0,4" TextWrapping="Wrap" />
            <DataGrid x:Name="Abilities" Grid.Row="4" ItemsSource="{Binding Abilities}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Effect / damage type" Binding="{Binding Name}" Width="Auto" />
                    <DataGridTextColumn Header="Damage" Binding="{Binding Damage, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="DPS" Binding="{Binding Dps, StringFormat=N1}" Width="Auto" />
                    <DataGridTextColumn Header="Share %" Binding="{Binding Percent, StringFormat=N1}" Width="Auto" />
                    <DataGridTextColumn Header="Direct landings" Binding="{Binding Landings, StringFormat=N0}" Width="Auto" />
                    <DataGridTextColumn Header="Full resists" Binding="{Binding Resists, StringFormat=N0}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
