<Window x:Class="EqLog.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EqLog.Overlay"
        xmlns:views="clr-namespace:EqLog.Overlay.Views"
        xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="EverQuest Log Overlay" Height="720" Width="680" MinWidth="480" MinHeight="420"
        Background="{DynamicResource NightBackground}" Foreground="{DynamicResource NightText}" FontSize="13">
    <Window.Resources>
        <local:AlertColorBrushConverter x:Key="AlertColorBrush" />
        <views:ProductConverter x:Key="SettingsHeightProduct" />
        <Style x:Key="LimitedSettingsScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Tag">
                <Setter.Value>
                    <sys:Double>0.1</sys:Double>
                </Setter.Value>
            </Setter>
            <Setter Property="MaxHeight">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource SettingsHeightProduct}">
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="SettingsRoot" Margin="10" LayoutTransform="{DynamicResource DisplayScaleTransform}">
        <TabControl x:Name="Tabs" TabStripPlacement="Top">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="SettingsTabScroll" DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1" />
                        </ScrollViewer>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
        <GroupBox Header="Display size">
            <StackPanel>
                <TextBlock Text="Resize text, images, and controls throughout the app." TextWrapping="Wrap" />
                <Grid Margin="0,6,0,0" Language="{x:Static views:CultureLanguage.Current}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="DisplayScaleSlider" Grid.ColumnSpan="2" Minimum="0.5" Maximum="2" TickFrequency="0.05"
                            SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" ValueChanged="DisplayScale_Changed" AutomationProperties.Name="Display size"
                            ToolTip="Scale app text, images, and controls from 50% to 200%. Panel text sizes are adjusted separately." />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center"
                               Text="{Binding Value, ElementName=DisplayScaleSlider, StringFormat={}{0:P0}}" />
                    <Button x:Name="ResetDisplayScaleButton" Grid.Row="1" Grid.Column="1" Content="Reset" Margin="0" Padding="6,2"
                            Click="ResetDisplayScale_Click" ToolTip="Restore the display size to 100%." />
                </Grid>
                <local:FixedLineTextBlock x:Name="DisplayScaleStatus" Foreground="{DynamicResource NightMuted}"
                                          Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>
                        <StackPanel Margin="4,2,4,16">
                            <TextBlock Text="EVERQUEST COMPANION" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Pumpkin}" />
                            <TextBlock Text="Your adventures, decoded." Foreground="{DynamicResource NightMuted}" Margin="0,3,0,0" />
                        </StackPanel>
        <GroupBox Header="Application updates" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock x:Name="AppVersionText" FontWeight="Bold" />
                <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates at startup and every 4 hours" Margin="0,6,0,0" Click="UpdatePreferences_Click" />
                <CheckBox x:Name="DownloadUpdatesBox" Content="Automatically download new stable releases" Margin="0,6,0,0" Click="UpdatePreferences_Click" />
                <CheckBox x:Name="UsageTelemetryBox" Content="Share usage and error telemetry" Margin="0,6,0,0" Click="TelemetryPreferences_Click"
                          ToolTip="Sends app starts, app version, feature actions, bundled theme choices (custom themes are labeled Custom), panel visibility and docked/floating placement, and error types to Application Insights. Game/log content, personal names, file paths, exception messages, and stack traces are not sent." />
                <local:FixedLineTextBlock x:Name="TelemetryStatusText" Margin="0,4,0,0" Foreground="{DynamicResource NightMuted}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdate_Click" local:UsageTracking.Action="CheckUpdates" />
                    <Button x:Name="DownloadUpdateButton" Content="Download update" IsEnabled="False" Click="DownloadUpdate_Click" local:UsageTracking.Action="DownloadUpdate" />
                    <Button x:Name="RestartUpdateButton" Content="Restart to update" IsEnabled="False" Click="RestartUpdate_Click" local:UsageTracking.Action="RestartToUpdate" />
                </WrapPanel>
                <ProgressBar x:Name="UpdateProgress" Maximum="100" Height="8" Visibility="Hidden" />
                <local:FixedLineTextBlock x:Name="UpdateStatusText" Margin="0,6,0,0" Foreground="{DynamicResource NightMuted}" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Log file" DockPanel.Dock="Top">
            <StackPanel>
                <ScrollViewer x:Name="LogFileScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <DockPanel>
                        <Button x:Name="BrowseLogButton" Content="Browse..." DockPanel.Dock="Right" Margin="6,0,0,0" Click="Browse_Click" local:UsageTracking.Action="BrowseLog" ToolTip="Pick a single eqlog file" />
                        <Button x:Name="ChooseFolderButton" Content="Choose folder..." DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6,7" Click="ChooseFolder_Click" local:UsageTracking.Action="ChooseLogFolder"
                                ToolTip="Pick your EverQuest Logs folder (or the EverQuest install folder); the newest eqlog file in it is used" />
                        <TextBox x:Name="LogPathBox" MinWidth="100" IsReadOnly="True" VerticalContentAlignment="Center" />
                    </DockPanel>
                </ScrollViewer>
                <CheckBox x:Name="FollowNewestBox" Content="Switch automatically to the newest eqlog file in this folder (character changes)" Margin="0,6,0,0" Click="FollowNewest_Click" />
                <ProgressBar x:Name="HistoryProgress" Height="6" Margin="0,6,0,0" Maximum="1" />
                <local:FixedLineTextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="{DynamicResource NightText}" />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="OverlaysGroup" Header="Overlays" DockPanel.Dock="Top">
            <StackPanel>
                <ScrollViewer x:Name="OverlayTogglesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="OverlayToggles" ItemsSource="{Binding Overlays}" MinWidth="352"
                              Width="{Binding ViewportWidth, ElementName=OverlayTogglesScroll}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OverlaySettingViewModel}">
                            <Grid Width="340" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Caption}" Tag="{Binding Key}" Margin="0,6,8,6"
                                          IsChecked="{Binding IsVisible}" />
                                <CheckBox Grid.Column="1" Content="docked" FontSize="11" VerticalAlignment="Center" Margin="0,6,0,6"
                                          Foreground="{DynamicResource NightMuted}"
                                          ToolTip="Show this panel in the selected workspace instead of as a floating overlay"
                                          IsChecked="{Binding IsDocked}" />
                                <ComboBox Grid.Column="2" MinWidth="128" MaxWidth="150" Margin="6,3,0,3" VerticalAlignment="Center"
                                          ToolTip="Move this overlay to a workspace" Tag="{Binding Key}"
                                          ItemsSource="{Binding WorkspaceChoices}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedWorkspace}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <CheckBox x:Name="LockBox" Content="Lock all overlays (click-through)    Ctrl+Shift+L" Margin="0,6,0,0" FontWeight="Bold" Click="Lock_Click"
                          ToolTip="Checked: all locked. Dash: mixed locks. Click or use the hotkey to lock all; when all are locked, unlock all." />
                <CheckBox x:Name="GameVisibleBox" Content="Only show floating overlays while EverQuest (eqgame.exe) is active" Margin="0,6,0,0" Click="GameVisible_Click"
                          ToolTip="When the game is inactive, floating overlays hide without moving into the dock. An unlocked floating overlay can keep focus for interaction." />
                <CheckBox x:Name="HoverChromeBox" Content="Hide floating overlay titles and borders in game unless hovered" Margin="0,6,0,0" Click="HoverChrome_Click"
                          ToolTip="Hide titles, borders and decorations until the mouse is over a floating overlay while EverQuest is active. Docked panels are unchanged. Locked overlays remain click-through." />
                <Expander Header="Individual overlay appearance and locks" Margin="0,8,0,0">
                    <ScrollViewer x:Name="OverlayAppearanceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="OverlayAppearance" Margin="0,6,0,0" ItemsSource="{Binding Overlays}"
                                  Language="{x:Static views:CultureLanguage.Current}" MinWidth="340"
                                  Width="{Binding ViewportWidth, ElementName=OverlayAppearanceScroll}">
                        <ItemsControl.Resources>
                            <Style x:Key="AppearanceRow" TargetType="Grid">
                                <Setter Property="Margin" Value="0,4,0,4" />
                            </Style>
                            <Style x:Key="AppearanceValue" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverlaySettingViewModel}">
                                <Expander Header="{Binding Caption}">
                                    <StackPanel Margin="8,4,8,8">
                                        <CheckBox Content="Locked (click-through)" Margin="0,4,0,8"
                                                  ToolTip="Locks this floating overlay only. Docked panels remain interactive. Unlock here to move or resize it."
                                                  IsChecked="{Binding IsLocked}" />
                                        <Grid Style="{StaticResource AppearanceRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Text size" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="9" Maximum="22" TickFrequency="1" SmallChange="1" LargeChange="2"
                                                    IsSnapToTickEnabled="True" ToolTip="{Binding FontSizeToolTip}" Value="{Binding FontSize}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource AppearanceValue}" Text="{Binding FontSize, StringFormat={}{0:0} pt}" />
                                        </Grid>
                                        <Grid Style="{StaticResource AppearanceRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Background" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                                    IsSnapToTickEnabled="True" ToolTip="{Binding BackgroundToolTip}" Value="{Binding BackgroundOpacity}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource AppearanceValue}" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
                                        </Grid>
                                        <Grid Style="{StaticResource AppearanceRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Mouse-over background" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                                    IsSnapToTickEnabled="True" ToolTip="{Binding HoverBackgroundToolTip}" Value="{Binding HoverBackgroundOpacity}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource AppearanceValue}" Text="{Binding HoverBackgroundOpacity, StringFormat={}{0:P0}}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Expander>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Reset session stats" Click="ResetSession_Click" local:UsageTracking.Action="ResetSession" />
                    <Button Content="Reset overlay positions" Click="ResetPositions_Click" local:UsageTracking.Action="ResetOverlayPositions" />
                    <Button Content="Dock all" Click="DockAll_Click" local:UsageTracking.Action="DockAll" ToolTip="Move every panel except Alerts into the docked window" />
                    <Button Content="Float all" Click="FloatAll_Click" local:UsageTracking.Action="FloatAll" ToolTip="Show every panel as a floating overlay again" />
                    <CheckBox x:Name="ResetOnLoginBox" Content="Reset stats when you log in" VerticalAlignment="Center" Margin="6,0,0,0" Click="ResetOnLogin_Click" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Tracking data" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Back up and reset learned tracking data, then close. Open the app again to reprocess the selected log. Settings and alert triggers are kept."
                           TextWrapping="Wrap" />
                <Button x:Name="ResetTrackingDataButton" Content="Reset tracking data..." HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="ResetTrackingData_Click" local:UsageTracking.Action="ResetTrackingData" />
                <local:FixedLineTextBlock x:Name="ResetTrackingDataStatus" Foreground="{DynamicResource NightMuted}" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Wiki caches" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Clear all cached NPCs, spells, item quest references, Sky quests, tradeskills, and item effects. Next lookups fetch fresh wiki information without restarting. Tracking history, inventory, and settings are kept."
                           TextWrapping="Wrap" />
                <Button x:Name="ResetWikiCacheButton" Content="Reset all wiki caches" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Click="ResetWikiCache_Click" />
                <local:FixedLineTextBlock x:Name="ResetWikiCacheStatus" Foreground="{DynamicResource NightMuted}" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="ChatChannelsGroup" Header="Chat channels" DockPanel.Dock="Top">
            <ItemsControl x:Name="ChatToggles" ItemsSource="{Binding ChatChannels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatChannelOptionViewModel}">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" Width="140" Margin="0,6,10,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
        <GroupBox Header="Consider / mob information">
            <StackPanel>
                <TextBlock Text="Use /consider in game to show Mob info. Resistance observations are saved by zone and mob name." TextWrapping="Wrap" />
                <ScrollViewer x:Name="MobOptionsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Show for (seconds):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="MobTimeoutBox" Width="65" Text="{Binding TimeoutText, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="0 = until next consider" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <local:FixedLineTextBlock x:Name="MobInfoStatusText" Margin="0,6,0,0" Foreground="{DynamicResource NightMuted}" Text="{Binding StatusText}" />
            </StackPanel>
        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TriggersTab" Header="Alert triggers">
                <DockPanel Margin="4">
                    <ScrollViewer x:Name="TriggerHelpScroll" DockPanel.Dock="Top" Style="{StaticResource LimitedSettingsScroll}">
                        <ScrollViewer.Tag>
                            <sys:Double>0.08</sys:Double>
                        </ScrollViewer.Tag>
                        <Border Background="{DynamicResource NightRaised}" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                            <TextBlock Foreground="{DynamicResource NightText}" TextWrapping="Wrap">
                                <Run FontWeight="Bold" Foreground="{DynamicResource Pumpkin}" Text="{}{C} means your character's full name." />
                                <LineBreak />
                                <Run Text="The name comes from the log filename. Use {C} in either the Regex or Alert text; it changes automatically when you switch characters." />
                                <LineBreak />
                                <Run Text="Example regex: ^{C} has fallen to the ground\.$" />
                                <LineBreak />
                                <Run Text="For Quethrosar, this matches: Quethrosar has fallen to the ground." />
                            </TextBlock>
                        </Border>
                    </ScrollViewer>
                    <ScrollViewer x:Name="TriggerNotesScroll" DockPanel.Dock="Bottom" Style="{StaticResource LimitedSettingsScroll}">
                        <ScrollViewer.Tag>
                            <sys:Double>0.07</sys:Double>
                        </ScrollViewer.Tag>
                        <TextBlock Foreground="{DynamicResource NightMuted}" TextWrapping="Wrap"
                                   Text="Simple text matches anywhere in the line, ignoring case, with no special characters. Regex is matched (case-insensitive) against the text after the [timestamp]. A trigger fires when Simple text OR Regex matches; fill in either or both. {C} = your character name in both. In the alert text, $1 or ${name} insert regex captured groups. Delay waits that many seconds after a match before alerting (for example, a recast timer) and shows a countdown meanwhile. Cooldown ignores repeat matches for that many seconds after a trigger fires, so a burst of lines shows one alert. Only new lines fire alerts, not history. Use Add trigger for a new one. Click a trigger (or its left edge; Ctrl/Shift-click for several), then use Delete selected; confirmation is required." />
                    </ScrollViewer>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Test" DockPanel.Dock="Right" Margin="6,0,0,0" Click="TestTrigger_Click" local:UsageTracking.Action="TestTrigger" />
                        <TextBlock Text="Test a line:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource NightText}" DockPanel.Dock="Left" />
                        <TextBox x:Name="TestLineBox" VerticalContentAlignment="Center"
                                 ToolTip="Paste a log line (without the [timestamp]) and click Test to see which triggers match and preview the alert." Text="Quethrosar has fallen to the ground." />
                    </DockPanel>
                    <TextBlock x:Name="TriggerStatusText" DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="#FF8080" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer x:Name="TriggerActionsScroll" DockPanel.Dock="Top"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Add trigger" Click="AddTrigger_Click" local:UsageTracking.Action="AddTrigger" ToolTip="Add a new, empty alert trigger" />
                            <Button x:Name="DeleteTriggersButton" Content="Delete selected" IsEnabled="False"
                                    Click="DeleteTriggers_Click" local:UsageTracking.Action="DeleteTriggers"
                                    ToolTip="Delete the selected alert triggers after confirmation" />
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid x:Name="TriggersGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Row" RowHeaderWidth="14" RowHeight="NaN" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                              HorizontalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel"
                              Binding.SourceUpdated="TriggerField_SourceUpdated"
                              PreviewGotKeyboardFocus="Triggers_PreviewGotKeyboardFocus"
                              SelectionChanged="Triggers_SelectionChanged">
                        <DataGrid.CommandBindings>
                            <CommandBinding Command="{x:Static DataGrid.DeleteCommand}"
                                            CanExecute="DeleteTriggers_CanExecute" Executed="DeleteTriggers_Executed" />
                        </DataGrid.CommandBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Trigger" Width="*" MinWidth="330">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- No row BindingGroup: each field saves on its own instead of waiting for a DataGrid row commit. -->
                                        <Grid Margin="0,4,0,6" BindingGroup="{x:Null}">
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource NightMuted}" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Margin" Value="0,0,8,0" />
                                                </Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Padding" Value="6,4" />
                                                    <Setter Property="Margin" Value="0,3,12,3" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Name" ToolTip="A label for this trigger. It names the countdown while a Delay is running.&#10;Example: Recast Dirge" />
                                            <TextBox Grid.Column="1" Tag="Name" FontWeight="SemiBold"
                                                     Text="{Binding Name, NotifyOnSourceUpdated=True}"
                                                     ToolTip="A label for this trigger. It names the countdown while a Delay is running.&#10;Example: Recast Dirge" />
                                            <TextBlock Grid.Column="2" Text="Alert text" ToolTip="What the alert says. Leave empty to show the matched log line.&#10;$1 or ${name} insert regex captured groups; {C} is your character name.&#10;Example: Recast Denon's!" />
                                            <TextBox Grid.Column="3" Tag="AlertText" Margin="0,3,0,3"
                                                     Text="{Binding Text, NotifyOnSourceUpdated=True}"
                                                     ToolTip="What the alert says. Leave empty to show the matched log line.&#10;$1 or ${name} insert regex captured groups; {C} is your character name.&#10;Example: Recast Denon's!" />

                                            <TextBlock Grid.Row="1" Text="Simple text" ToolTip="Plain text found anywhere in the line, ignoring case. No special characters.&#10;{C} is your character name.&#10;Example: your Denon's Desperate Dirge" />
                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                     Text="{Binding Simple, NotifyOnSourceUpdated=True}"
                                                     ToolTip="Plain text found anywhere in the line, ignoring case. No special characters.&#10;{C} is your character name.&#10;Example: your Denon's Desperate Dirge" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="or Regex" ToolTip="A regular expression matched (ignoring case) against the text after [timestamp].&#10;Use this or Simple text; either one firing triggers the alert. {C} is your character name.&#10;Example: ^{C} has fallen to the ground\.$" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,3,0,3" FontFamily="Consolas"
                                                     Text="{Binding Pattern, NotifyOnSourceUpdated=True}"
                                                     ToolTip="A regular expression matched (ignoring case) against the text after [timestamp].&#10;Use this or Simple text; either one firing triggers the alert. {C} is your character name.&#10;Example: ^{C} has fallen to the ground\.$" />

                                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,3,0,0">
                                                <CheckBox Content="Enabled" VerticalAlignment="Center" ToolTip="Uncheck to turn this trigger off without deleting it."
                                                          IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                                <TextBlock Text="Secs" ToolTip="How many seconds the alert stays on screen. Default 8." />
                                                <TextBox Width="52" Text="{Binding Seconds, NotifyOnSourceUpdated=True}"
                                                         ToolTip="How many seconds the alert stays on screen. Default 8." />
                                                <TextBlock Text="Delay" ToolTip="Seconds to wait after a match before alerting, such as a recast timer.&#10;A countdown shows in the Alerts overlay while waiting. 0 = alert right away." />
                                                <TextBox Width="52" Text="{Binding DelaySeconds, NotifyOnSourceUpdated=True}"
                                                         ToolTip="Seconds to wait after a match before alerting, such as a recast timer.&#10;A countdown shows in the Alerts overlay while waiting. 0 = alert right away." />
                                                <CheckBox Content="Restart on repeat" VerticalAlignment="Center" Margin="0,0,14,0"
                                                          IsChecked="{Binding RestartDelay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                                          ToolTip="With a delay: if the line shows up again during the countdown, start it over. Unchecked ignores repeats until the alert shows." />
                                                <TextBlock Text="Cooldown" ToolTip="After this trigger fires, ignore more matching lines for this many seconds,&#10;so a burst of lines shows one alert. 0 = alert on every line. Default 2." />
                                                <TextBox Width="52" Text="{Binding CooldownSeconds, NotifyOnSourceUpdated=True}"
                                                         ToolTip="After this trigger fires, ignore more matching lines for this many seconds,&#10;so a burst of lines shows one alert. 0 = alert on every line. Default 2." />
                                                <CheckBox Content="Sound" VerticalAlignment="Center"
                                                          IsChecked="{Binding Sound, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                                          ToolTip="Play the Windows exclamation sound" />
                                                <TextBlock Text="Effect" ToolTip="How the alert text moves in the Alerts overlay." />
                                                <ComboBox Width="160" Margin="0,2,14,2" VerticalAlignment="Center"
                                                          ItemsSource="{x:Static local:AlertEffects.Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Effect, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                                          ToolTip="How the alert text moves in the Alerts overlay" />
                                                <TextBlock Text="Color" ToolTip="The alert text color: a color name (Orange) or #RRGGBB. Use Pick... to choose one." />
                                                <Border Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="3"
                                                        BorderBrush="{DynamicResource NightMuted}" BorderThickness="1"
                                                        Background="{Binding Color, Converter={StaticResource AlertColorBrush}}" />
                                                <TextBox Width="90" Tag="Color" Margin="0,3,6,3"
                                                         Text="{Binding Color, NotifyOnSourceUpdated=True}"
                                                         ToolTip="The alert text color: a color name (Orange) or #RRGGBB. Use Pick... to choose one." />
                                                <Button Content="Pick..." Padding="8,3" Margin="0,2,0,2" VerticalAlignment="Center"
                                                        Click="TriggerColorPick_Click" ToolTip="Choose the alert color" />
                                            </WrapPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="LogLinesTab" Header="Log lines">
                <DockPanel Margin="4">
                    <ScrollViewer x:Name="LogActionsScroll" DockPanel.Dock="Top"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="Make trigger" DockPanel.Dock="Right" Margin="6,0,0,0" Click="MakeTrigger_Click" local:UsageTracking.Action="MakeTriggerFromLog"
                                    ToolTip="Create an alert trigger from the selected line (or double-click a line)" />
                            <Button Content="Copy message" DockPanel.Dock="Right" Margin="6,0,0,0" Click="CopyLogMessage_Click"
                                    ToolTip="Copy the selected message without its timestamp. Paste it into an existing trigger and edit as needed." />
                            <CheckBox x:Name="PauseLinesBox" Content="Pause" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Click="RawFilter_Changed" />
                            <CheckBox x:Name="RegexFilterBox" Content="Regex" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Click="RawFilter_Changed"
                                      ToolTip="Treat the filter as a trigger regex ({C} = your name) to test it against real lines" />
                            <TextBlock Text="Filter:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource NightText}" />
                            <TextBox x:Name="RawFilterBox" MinWidth="100" VerticalContentAlignment="Center" TextChanged="RawFilter_Changed" />
                        </DockPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="RawStatusText" DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="{DynamicResource NightMuted}" TextWrapping="Wrap" />
                    <ListBox x:Name="RawLinesList" FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="RawLines_DoubleClick" KeyDown="RawLines_KeyDown" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="SpawnsTab" Header="Spawn timers">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox x:Name="ShowAllMobsBox" Content="Show all mobs" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Click="ShowAllMobs_Click"
                                  ToolTip="Also list generic mobs (a/an ...) and names that might be players" />
                        <TextBlock x:Name="SpawnZoneText" Foreground="{DynamicResource Pumpkin}" FontWeight="Bold" VerticalAlignment="Center" Text="Zone: -" />
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Bottom" Style="{StaticResource LimitedSettingsScroll}">
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource NightMuted}" TextWrapping="Wrap"
                                   Text="Tick Track to time mobs in the Spawn Timers overlay. Priority: Override, then Learned, then Wiki. Until a time is learned, tracked mobs are checked on EQLWiki in the background. Wiki times may differ on Legends or instance variants. Override accepts seconds or m:ss; clear it to use Learned or Wiki. Learning measures kill to next sighting without zoning; instances share learned times. Relearn forgets the learned time and measures it again from your next kill." />
                    </ScrollViewer>
                    <DataGrid x:Name="SpawnsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CellEditEnding="Spawns_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Track" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Tracked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" Click="SpawnTrack_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Mob" IsReadOnly="True" Width="*" SortMemberPath="Mob">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <views:WikiLabel x:Name="SpawnMobLabel" Subject="{Binding Mob}" Kind="Mob">
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Hyperlink Tag="{Binding Mob}" Click="NpcWikiLink_Click"
                                                           Foreground="{DynamicResource Pumpkin}" ToolTip="Open mob on EQLWiki">
                                                    <Run Text="{Binding Mob, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </views:WikiLabel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kills" Binding="{Binding Kills}" IsReadOnly="True" Width="45" />
                            <DataGridTextColumn Header="Last killed" Binding="{Binding LastKilled}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Learned" Binding="{Binding Learned}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Wiki" Binding="{Binding Wiki}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Override" Binding="{Binding Override}" Width="70" />
                            <DataGridTemplateColumn Header="Action" Width="90" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Relearn" Click="RelearnSpawn_Click" local:UsageTracking.Action="RelearnSpawn" Padding="8,1" Margin="0"
                                                MinHeight="22" VerticalAlignment="Center" IsEnabled="{Binding HasSamples}"
                                                ToolTip="Forget the learned respawn time and measure it again from your next kill" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- Hosted at runtime in the "Inventory & loot quests" overlay; the tab itself is removed on startup. -->
            <TabItem x:Name="LootQuestsTab" Header="Loot quests" Visibility="Collapsed">
                <DockPanel x:Name="LootQuestsContent" Margin="2">
                    <StackPanel DockPanel.Dock="Top">
                        <Expander Header="How inventory and ownership work" Foreground="{DynamicResource NightMuted}" Margin="0,0,0,8">
                            <TextBlock Foreground="{DynamicResource NightMuted}" TextWrapping="Wrap" Margin="4,8"
                                       Text="All inventory sections and loot are looked up automatically on EQLWiki (only item names are sent). A [Quest] marker appears when cached quest references exist; click it to view them. No marker may mean the lookup is still pending. Owned is the confirmed sum of Carried, Bank, Hoard, Depot, and Other from the last export. Collections and installed augments are counted separately. Loot logs do not change Owned. Run /outputfile inventory after looting, merging, sales, or turn-ins to refresh counts and locations. Quest references may include rewards." />
                        </Expander>
                        <local:FixedLineTextBlock x:Name="InventoryStatus" Lines="3" Margin="0,4"
                                   Foreground="{DynamicResource NightText}"
                                   Text="{Binding ImportStatus}" />
                        <WrapPanel>
                            <Button x:Name="LookupQuestButton" Content="Look up quests" Click="LookupQuest_Click" />
                            <Button Content="Item wiki page" Click="OpenItemWiki_Click" local:UsageTracking.Action="OpenItemWiki" />
                            <Button Content="Open selected quest" Click="OpenQuest_Click" local:UsageTracking.Action="OpenQuest" />
                            <Button Content="Complete / reopen quest" Click="CompleteQuest_Click" local:UsageTracking.Action="CompleteQuest" />
                            <Button Content="Retry lookups" Click="RetryQuests_Click" local:UsageTracking.Action="RetryQuestLookups" />
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="90" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="3*" MinHeight="90" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR INVENTORY" Foreground="{DynamicResource NightMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,6" />
                            <TextBox x:Name="InventoryItemFilter" Margin="0,0,0,6" VerticalContentAlignment="Center"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Item name filter"
                                     ToolTip="Filter inventory by item name (case-insensitive). Clear to show all. Unlock floating panels to type." />
                        </StackPanel>
                        <DataGrid x:Name="QuestOwnedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="QuestItem_Selected"
                                  Grid.Row="1" MinColumnWidth="70">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item" IsReadOnly="True" Width="*" MinWidth="190" SortMemberPath="Item">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasQuestReferences}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Hyperlink Tag="{Binding Item}" Click="QuestBadge_Click"
                                                               Foreground="{DynamicResource Pumpkin}"
                                                               ToolTip="Quest references available: click to view. Wiki mentions may include ingredients or rewards, not a turn-in checklist.">
                                                        <Run Text="[Quest]" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Hyperlink Tag="{Binding Item}" Click="InventoryItem_Click"
                                                               Foreground="{DynamicResource Pumpkin}" ToolTip="Show all copy locations and quest references. Use Item wiki page to open EQLWiki.">
                                                        <Run Text="{Binding Item}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Carried" Binding="{Binding Carried}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Hoard" Binding="{Binding Hoard}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Depot" Binding="{Binding Depot}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Other" Binding="{Binding OtherStorage}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding Collection}" IsReadOnly="True" MinWidth="90" />
                                <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" IsReadOnly="True" MinWidth="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="{DynamicResource NightBorder}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Drag to resize the inventory and quest lists" />
                        <TabControl x:Name="InventoryDetailsTabs" Grid.Row="3">
                            <TabItem Header="Copy locations">
                                <DockPanel>
                                    <TextBlock x:Name="InventoryCopiesStatus" DockPanel.Dock="Top" TextWrapping="Wrap"
                                               Foreground="{DynamicResource NightMuted}" Margin="0,4,0,6"
                                               Text="{Binding CopyStatus}" />
                                    <DataGrid x:Name="InventoryCopiesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                              ItemsSource="{Binding Copies}"
                                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                              AutomationProperties.Name="Selected item copy locations">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" MinWidth="170" />
                                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank, StringFormat=+{0}}" Width="55" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" MinWidth="240" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Quest references">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="QUEST REFERENCES" Foreground="{DynamicResource NightMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,4" />
                                        <local:FixedLineTextBlock x:Name="QuestLookupStatus" Lines="2" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource Pumpkin}"
                                                   Text="Lookups are cached for seven days. Enable the Quest opportunities panel to see all matching quests." />
                                    </StackPanel>
                                    <ListBox x:Name="QuestResults" HorizontalContentAlignment="Stretch"
                                             ToolTip="Click a quest name to open it on EQLWiki, or select a row for Complete / reopen. Owned is confirmed by the last inventory export. Carried includes equipped items.">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Hyperlink Tag="{Binding Url}" Click="UrlWikiLink_Click"
                                                               Foreground="{DynamicResource Pumpkin}" ToolTip="Open quest on EQLWiki">
                                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="DurationsTab" Header="Spell durations">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Add a spell and its duration in seconds" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ScrollViewer x:Name="DurationEntryScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add / update" Click="AddDuration_Click" local:UsageTracking.Action="AddDuration" />
                            <TextBox x:Name="NewDurationSecondsBox" DockPanel.Dock="Right" Width="75" Margin="4,0"
                                     ToolTip="Duration in seconds" AutomationProperties.Name="Spell duration in seconds" />
                            <TextBox x:Name="NewDurationSpellBox" MinWidth="100" ToolTip="Spell name, including rank if desired"
                                     AutomationProperties.Name="Spell name" />
                        </DockPanel>
                    </ScrollViewer>
                </StackPanel>
                <ScrollViewer DockPanel.Dock="Bottom" Style="{StaticResource LimitedSettingsScroll}">
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource NightMuted}" TextWrapping="Wrap"
                               Text="Override takes priority, then learned duration, then the wiki estimate (ticks are 6 seconds). Wiki lookups run in the background for spells you cast. Uncheck Track to hide timers but keep learning. Relearn forgets the learned duration and measures it again from your next casts. Remove deletes this spell/rank and prevents automatic rediscovery until you add it again." />
                </ScrollViewer>
                <DataGrid x:Name="DurationsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CellEditEnding="Durations_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Track" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Tracked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" Click="DurationTrack_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Spell" Binding="{Binding Spell}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Learned" Binding="{Binding Learned}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="Wiki" Binding="{Binding Wiki}" IsReadOnly="True" Width="65" />
                        <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" IsReadOnly="True" Width="70" />
                        <DataGridTextColumn Header="Override (s)" Binding="{Binding Override}" Width="100" />
                        <DataGridTemplateColumn Header="Action" Width="170" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Relearn" Click="RelearnDuration_Click" local:UsageTracking.Action="RelearnDuration" Padding="8,1" Margin="0,0,6,0"
                                                MinHeight="22" VerticalAlignment="Center" IsEnabled="{Binding HasSamples}"
                                                ToolTip="Forget the learned duration and measure it again from your next casts" />
                                        <Button Content="Remove" Click="RemoveDuration_Click" local:UsageTracking.Action="RemoveDuration" Padding="8,1" Margin="0"
                                                MinHeight="22" VerticalAlignment="Center"
                                                ToolTip="Remove this spell/rank until manually added again" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            </TabItem>
            <TabItem x:Name="AppearanceTab" Header="Appearance">
                <DockPanel Margin="8">
                    <ScrollViewer x:Name="ThemeSettingsScroll" DockPanel.Dock="Top"
                                  Style="{StaticResource LimitedSettingsScroll}" HorizontalScrollBarVisibility="Auto">
                        <ScrollViewer.Tag>
                            <sys:Double>0.4</sys:Double>
                        </ScrollViewer.Tag>
                        <GroupBox Header="Theme" MinWidth="240"
                                  Width="{Binding ViewportWidth, ElementName=ThemeSettingsScroll}">
                            <StackPanel>
                                <CheckBox x:Name="FollowWindowsThemeBox" Content="Follow Windows light/dark mode"
                                          Margin="0,0,0,8" Checked="FollowWindowsTheme_Changed" Unchecked="FollowWindowsTheme_Changed" />
                                <DockPanel>
                                    <Button Content="Import JSON..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="ImportTheme_Click" local:UsageTracking.Action="ImportTheme" />
                                    <ComboBox x:Name="ThemePicker" DisplayMemberPath="Name" SelectionChanged="Theme_Changed" />
                                </DockPanel>
                                <local:FixedLineTextBlock x:Name="ThemeStatus" Foreground="{DynamicResource NightMuted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </ScrollViewer>
                    <ContentControl x:Name="ThemeEditorHost" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
