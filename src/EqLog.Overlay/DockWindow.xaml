<Window x:Class="EqLog.Overlay.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EqLog.Overlay"
        xmlns:views="clr-namespace:EqLog.Overlay.Views"
        xmlns:vm="clr-namespace:EqLog.Overlay.ViewModels"
        Title="EverQuest Log Overlay" Icon="pack://application:,,,/EqLogOverlay;component/AppIcon.ico"
        MinWidth="420" MinHeight="300" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource NightBackground}" Foreground="{DynamicResource NightText}">
    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="DockVisibleWhenTrue" />

        <Style x:Key="TopBarNotice" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:UpdateNoticeViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Text}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Pumpkin}" />
                <Button Content="{Binding ActionText}" Command="{Binding Action}" IsEnabled="{Binding CanAct}"
                        Padding="8,2" Margin="0" VerticalAlignment="Center" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="WorkspaceTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTip" Value="Select workspace. Right-click for rename or delete." />
            <Setter Property="Foreground" Value="{DynamicResource NightText}" />
            <Setter Property="Background" Value="{DynamicResource NightBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NightBorder}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NightRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Pumpkin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ScrollViewer x:Name="MainToolbarScroll" DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <DockPanel x:Name="MainToolbar" Margin="8,6,8,2"
                       LayoutTransform="{DynamicResource DisplayScaleTransform}">
                <ToggleButton x:Name="SideToggle" DockPanel.Dock="Left" Content="&#x2699; Settings"
                              IsChecked="{Binding IsSidePanelOpen, Mode=OneWay}" Padding="8,2" Margin="0,0,10,0"
                              ToolTip="Show or hide the settings panel" Focusable="False"
                              local:UsageTracking.Action="ToggleSettings" Click="SideToggle_Click" />
                <ContentControl x:Name="Notice" Content="{Binding Notice}" Style="{StaticResource TopBarNotice}" />
                <!-- The source is MainWindow's progress bar, so it is the data context rather than the content. -->
                <ContentControl x:Name="HistoryLoadingNotice" DataContext="{Binding LoadingNotice}" Margin="0,0,10,0"
                                DockPanel.Dock="Left">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tag}" Margin="0,0,8,0" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource NightText}" />
                                <ProgressBar Value="{Binding Value, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                             Maximum="1" Width="70" Height="6" VerticalAlignment="Center" />
                            </StackPanel>
                        </ControlTemplate>
                    </ContentControl.Template>
                </ContentControl>
                <CheckBox x:Name="AutoArrangeBox" DockPanel.Dock="Right" Content="Auto-arrange"
                          IsChecked="{Binding AutoArrange}" VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="{DynamicResource NightText}"
                          ToolTip="Automatically rearrange docked panels to fill empty space. Untick so panels only move when you drag or resize them."
                          local:UsageTracking.Action="ToggleAutoArrange" Click="AutoArrange_Click" />
                <Button x:Name="WhatsNewButton" DockPanel.Dock="Right" Content="What's New" Padding="8,2" Margin="0,0,10,0"
                        ToolTip="Read what's new and how to use this release's features" Click="WhatsNew_Click" />
                <TextBlock Text="{Binding DragHint}" VerticalAlignment="Center" Foreground="{DynamicResource NightMuted}" />
            </DockPanel>
        </ScrollViewer>

        <DockPanel x:Name="WorkspaceToolbar" DockPanel.Dock="Top" Margin="8,4,8,0"
                   LayoutTransform="{DynamicResource DisplayScaleTransform}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,8,0">
                <Button Content="+" Padding="10,4" Margin="4,0,0,4" ToolTip="Create a workspace"
                        Click="CreateWorkspace_Click" />
                <Button x:Name="RestoreWorkspaceButton" Content="Restore" Margin="4,0,0,4"
                        IsEnabled="{Binding CanRestoreWorkspace}" Click="RestoreWorkspaceButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding DeletedWorkspaces}" DisplayMemberPath="Name">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <EventSetter Event="Click" Handler="RestoreWorkspace_Click" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="WorkspaceTabs" ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DockWorkspaceTab}">
                            <Button Content="{Binding Name}" Style="{StaticResource WorkspaceTab}"
                                    Click="WorkspaceTab_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Click="RenameWorkspace_Click" />
                                        <MenuItem Header="Delete" Click="DeleteWorkspace_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>
            <!-- The settings UI keeps its own (null) data context rather than inheriting this window's view model. -->
            <Border x:Name="SidePanel" Grid.Column="0" DataContext="{x:Null}"
                    Visibility="{Binding DataContext.IsSidePanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DockVisibleWhenTrue}}" />
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the settings panel"
                          Background="{DynamicResource NightBorder}"
                          Visibility="{Binding IsSidePanelOpen, Converter={StaticResource DockVisibleWhenTrue}}"
                          DragStarted="Splitter_DragStarted" DragCompleted="Splitter_DragCompleted" />
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="TilesArea" Background="Transparent" AllowDrop="True"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              SizeChanged="TilesArea_SizeChanged" PreviewDragOver="TilesArea_PreviewDragOver"
                              PreviewDrop="TilesArea_PreviewDrop">
                    <Canvas x:Name="Tiles" Background="Transparent">
                        <Border x:Name="DropPreview" BorderThickness="2" CornerRadius="6" VerticalAlignment="Top"
                                IsHitTestVisible="False" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Pumpkin}" Background="{DynamicResource NightRaised}"
                                TextElement.Foreground="{DynamicResource Pumpkin}">
                            <TextBlock x:Name="DropPreviewText" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="10" FontWeight="SemiBold"
                                       LayoutTransform="{DynamicResource DisplayScaleTransform}" />
                        </Border>
                    </Canvas>
                </ScrollViewer>
                <TextBlock Margin="12" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{DynamicResource NightMuted}"
                           LayoutTransform="{DynamicResource DisplayScaleTransform}"
                           Visibility="{Binding IsWorkspaceEmpty, Converter={StaticResource DockVisibleWhenTrue}}"
                           Text="No panels are in this workspace. Tick &quot;docked&quot; next to an overlay in Settings, or click &#x2199; Dock on a floating overlay (while unlocked)." />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
